---
// Page de contrôle du système de design. À supprimer avant la mise en ligne.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import OfferCard from '../components/OfferCard.astro';
import ProofBand from '../components/ProofBand.astro';
import Quote from '../components/Quote.astro';
import Faq from '../components/Faq.astro';
import InterviewCard from '../components/InterviewCard.astro';
---
<Base title="Composants | Aurélien Mizeret">

  <section class="section section--ink">
    <div class="container">
      <SectionTitle eyebrow="Sur encre" title="La machine fonctionne. C'est la décision qui manque." level="h1">
        <p>Titre de niveau 1, chapô, et les deux seuls boutons du site.</p>
      </SectionTitle>
      <div class="actions">
        <Button href="/diagnostic/">Faire le diagnostic</Button>
        <Button href="/contact/" variant="secondary">Réserver un échange de 30 min</Button>
      </div>
    </div>
  </section>

  <ProofBand
    figures={[
      { value: '18 ans', label: "d'expérience en management humain et stratégie" },
      { value: '80', label: 'personnes encadrées' },
      { value: '6 pays', label: "d'intervention sur deux continents" },
    ]}
    clients={['Capgemini', 'Engie', 'EDF', 'France Télévisions', 'IPSEN']}
  />

  <section class="section section--light">
    <div class="container">
      <SectionTitle eyebrow="Sur fond clair" title="L'escalier des offres">
        <p>Cartes d'offre : la carte mise en avant prend le fond or très clair.</p>
      </SectionTitle>
      <div class="grid">
        <OfferCard title="Journée Décision IA" price="2 500 €" audience="Comex et Codir qui doivent trancher." href="/offres/journee-decision-ia/" featured badge="Pour commencer">
          <p>Une journée pour aligner la direction sur des critères de décision communs, avec un plan d'action remis sous 72 h.</p>
        </OfferCard>
        <OfferCard title="Cadrage de Décision IA" price="3 600 €" audience="Directions qui ont un projet IA à arbitrer." href="/offres/cadrage-de-decision-ia/">
          <p>Trois jours pour instruire une décision précise.</p>
        </OfferCard>
        <OfferCard title="Audit de Transition IA" price="8 000 à 12 000 €" audience="Organisations qui veulent une vue complète." href="/offres/audit-de-transition-ia/">
          <p>Une cartographie de vos risques et de vos leviers.</p>
        </OfferCard>
      </div>
      <div class="actions">
        <Button href="/offres/" variant="secondary">Voir toutes les offres</Button>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container stack">
      <SectionTitle title="Citations" />
      <Quote author="Prénom Nom" role="DRH, groupe industriel">
        <p>Verbatim ORSYS à venir : la citation s'affiche en Epilogue, sur le fond or très clair.</p>
      </Quote>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <Quote author="Prénom Nom" role="Directrice générale" tone="ink">
        <p>La même citation, en version encre, pour les sections sombres.</p>
      </Quote>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <SectionTitle eyebrow="Série d'entretiens" title="Ceux qui décident" />
      <div class="grid">
        <InterviewCard name="Ilham Mouhriz" organisation="Sothema" href="/observatoire-ia-entretien-avec-ilham-mouhriz-sothema/" />
        <InterviewCard name="Anne" organisation="Cabinet de conseil, Canada" href="/ia-nous-navons-pas-encadre-lusage-assez-vite/" />
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <SectionTitle title="Questions fréquentes" />
      <Faq items={[
        { question: 'Combien de temps dure la Journée Décision IA ?', answer: "Une journée sur site, précédée d'un brief avec la direction et suivie d'un point à 30 jours." },
        { question: 'Recommandez-vous des outils pendant la journée ?', answer: "Non. La journée porte sur les critères de décision. Le choix d'outils relève du Cadrage de Décision IA." },
      ]} />
    </div>
  </section>

</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .grid { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
