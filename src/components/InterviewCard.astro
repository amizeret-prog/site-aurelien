---
// Carte d'entretien « Ceux qui décident » : portrait réel, sinon initiales.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  href: string;
  role?: string;
  organisation?: string;
  excerpt?: string;
  image?: ImageMetadata;
}
const { name, href, role, organisation, excerpt, image } = Astro.props;
const fonction = [role, organisation].filter(Boolean).join(', ');
const initiales = name.split(/\s+/).map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---
<article class="interview">
  <div class="portrait">
    {image
      ? <Picture src={image} formats={['avif', 'webp']} alt="" widths={[120, 240]} sizes="120px" />
      : <span class="initials" aria-hidden="true">{initiales}</span>}
  </div>
  <span class="filet" aria-hidden="true"></span>
  <h3><a href={href}>{name}</a></h3>
  {fonction && <p class="role">{fonction}</p>}
  {excerpt && <p class="excerpt">« {excerpt} »</p>}
</article>

<style>
  .interview { background: var(--surface); color: var(--text); padding: 1.75rem; border-radius: var(--radius); height: 100%; }
  .portrait { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; background: var(--ink); margin-bottom: 1.25rem; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .initials { display: grid; place-items: center; height: 100%; font-family: var(--font-title); font-weight: 800; font-size: 2rem; color: var(--gold); }
  .filet { display: block; width: 3rem; height: 3px; background: var(--gold); margin: -0.25rem 0 1.25rem; }
  h3 { margin: 0 0 .25rem; font-size: 1.25rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--gold); }
  .role { font-size: .9375rem; color: var(--text-soft); margin: 0; }
  .excerpt { margin: 1rem 0 0; font-family: var(--font-title); font-weight: 600; color: var(--ink); }
</style>
