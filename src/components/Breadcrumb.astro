---
// Fil d'Ariane : situe la page, se lit de gauche à droite.
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Fil d'Ariane">
  <ol>
    {items.map((i, n) => (
      <li>
        {i.href && n < items.length - 1 ? <a href={i.href}>{i.label}</a> : <span aria-current="page">{i.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { margin-bottom: 2rem; font-size: .9375rem; color: var(--on-ink-soft); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem .5rem; }
  li + li::before { content: '/'; margin-right: .5rem; color: var(--gold); }
  a { color: var(--on-ink-soft); text-decoration: none; }
  a:hover { color: var(--gold); }
  [aria-current] { color: var(--on-ink); }
</style>
