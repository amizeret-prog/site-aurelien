---
const liens = [
  { href: '/diagnostic/', label: 'Diagnostic' },
  { href: '/offres/', label: 'Offres' },
  { href: '/ceux-qui-decident/', label: 'Ceux qui décident' },
  { href: '/livre/', label: 'Livre' },
  { href: '/a-propos/', label: 'À propos' },
];
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="logo">Aurélien Mizeret</a>

    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>{liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <a class="btn btn-primary cta" href="/contact/">Réserver un échange de 30 min</a>

    <details class="nav-mobile">
      <summary>Menu</summary>
      <nav aria-label="Navigation mobile">
        <ul>
          {liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a class="btn btn-primary" href="/contact/">Réserver un échange de 30 min</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: relative; border-bottom: 1px solid rgba(199, 171, 90, .25); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .logo { font-family: var(--font-title); font-weight: 800; color: var(--paper); text-decoration: none; font-size: 1.1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  a:not(.btn) { color: var(--paper); text-decoration: none; }
  a:not(.btn):hover { color: var(--gold); }

  .nav-desktop, .cta { display: none; }

  .nav-mobile summary { cursor: pointer; list-style: none; font-family: var(--font-title); font-weight: 700; }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile ul {
    position: absolute; left: 0; right: 0; top: 72px; z-index: 5;
    display: grid; gap: 1rem; padding: 1.25rem; background: var(--ink-deep);
  }

  @media (min-width: 960px) {
    .nav-mobile { display: none; }
    .nav-desktop, .cta { display: block; }
    .nav-desktop ul { display: flex; gap: 1.75rem; }
  }
</style>